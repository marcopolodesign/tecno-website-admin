# Staging Environment - Supabase
VITE_SUPABASE_URL=https://your-staging-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here
VITE_KIOSK_ACCESS_TOKEN=your-staging-kiosk-token-here

# NEVER put the service role key here or in any VITE_* var — see .env.example for why.
#
# Get your anon key from:
# https://supabase.com/dashboard/project/<your-staging-ref>/settings/api
