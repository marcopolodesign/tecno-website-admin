VITE_SUPABASE_URL=https://buntxbgjixlksffbscle.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Shared token the /acceso kiosk sends to the kiosk-set-password Edge Function.
# Not a real secret (it ships in the browser bundle like everything else here) — it just
# scopes that one endpoint to the kiosk UI instead of the open internet. Must match the
# KIOSK_ACCESS_TOKEN secret set on the Edge Function (`supabase secrets set`).
VITE_KIOSK_ACCESS_TOKEN=your-kiosk-token-here

# NEVER add VITE_SUPABASE_SERVICE_ROLE_KEY here or anywhere in this app. Every VITE_*
# var is inlined into the public JS bundle — a service role key here means every visitor
# of the admin URL gets a key that bypasses RLS entirely. Admin operations that need the
# service role (auth.admin.* — creating/deleting users, etc.) go through Edge Functions
# in tecnofit-supabase/supabase/functions/, which hold that key server-side only.
